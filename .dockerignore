# ── Git & Version Control ──
.git
.gitignore

# ── Secrets ──
.env
.env.local

# ── Python Virtual Environment ──
venv/
.venv/

# ── Python Bytecode & Caches ──
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ── Frontend (handled by frontend/Dockerfile separately) ──
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# ── Runtime Outputs (regenerated at runtime) ──
outputs/*.png
logs/

# ── IDE & OS ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Documentation (not needed at runtime) ──
docs/
ai_agent.md
README.md

# ── Tests (not needed in production image) ──
tests/

# ── Windows scripts ──
run.bat

# ── Docker files (avoid recursive context) ──
docker-compose.yml
frontend/Dockerfile
