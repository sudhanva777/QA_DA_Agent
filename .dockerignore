# ── Git & Version Control ──
.git
.gitignore

# ── Secrets ──
.env
.env.local
.env.*.local

# ── Python Virtual Environment ──
venv/
.venv/

# ── Python Bytecode & Caches ──
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# ── Frontend (handled by frontend/Dockerfile separately) ──
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ── Runtime Outputs (regenerated at runtime) ──
outputs/*.png
outputs/*.pdf
!outputs/.gitkeep
logs/
!logs/.gitkeep
logs/*.db
!logs/.gitkeep
logs/cache/

# ── IDE & OS ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Documentation (not needed at runtime) ──
docs/
ai_agent.md
README.md

# ── Tests (not needed in production image) ──
tests/
*.cover
.coverage

# ── Docker files (avoid recursive context) ──
docker-compose.yml
frontend/Dockerfile

# ── Windows scripts ──
run.bat

# ── Alembic (migrations handled separately) ──
alembic/
alembic.ini

# ── Misc ──
*.log
*.pot
*.pyc
*.pyo